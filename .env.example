# PostgreSQL connection string. When unset, the app uses embedded PGlite instead.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance

# PGlite data directory used when DATABASE_URL is unset.
# Default is memory:// (data is lost on restart). Use a directory to keep data in development.
PGLITE_DATA_DIR=.pglite

# Shared password of the demo accounts (admin, manager, yamada, suzuki). Required by `pnpm db:seed`
# and by SEED_DEMO_DATA. Use a value of 8 characters or more.
SEED_PASSWORD=

# Seed the demo accounts and attendance every time PGlite starts (PGlite only, never PostgreSQL).
# SEED_DEMO_DATA=true

# Used by `pnpm db:create-admin` to create the first admin in production.
# ADMIN_LOGIN_ID=
# ADMIN_DISPLAY_NAME=
# ADMIN_PASSWORD=
